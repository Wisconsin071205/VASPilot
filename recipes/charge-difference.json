{
  "id": "charge-difference",
  "version": "1.0.0",
  "parameters_schema": {
    "type": "object",
    "properties": {
      "potcar_profile": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
      "kpoints_profile": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
      "resource_profile": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
    },
    "required": ["potcar_profile", "kpoints_profile", "resource_profile"],
    "additionalProperties": false
  },
  "stages": [
    {"id": "validate-branches", "type": "validate", "validator": "charge.branches.validate", "artifacts_in": ["total/POSCAR", "fragment-a/POSCAR", "fragment-b/POSCAR"], "artifacts_out": ["branch-validation.json"]},
    {"id": "total-scf", "type": "scf", "depends_on": ["validate-branches"], "input_policy": {"branch": "total", "shared-grid": true}, "artifacts_out": ["total/CHGCAR", "total/OUTCAR"], "resource_profile": {"parameter": "resource_profile"}, "approval_gate": true, "recovery_policy": {"mode": "propose-only"}},
    {"id": "fragment-a-scf", "type": "scf", "depends_on": ["validate-branches"], "input_policy": {"branch": "fragment-a", "shared-grid": true}, "artifacts_out": ["fragment-a/CHGCAR", "fragment-a/OUTCAR"], "resource_profile": {"parameter": "resource_profile"}, "recovery_policy": {"mode": "propose-only"}},
    {"id": "fragment-b-scf", "type": "scf", "depends_on": ["validate-branches"], "input_policy": {"branch": "fragment-b", "shared-grid": true}, "artifacts_out": ["fragment-b/CHGCAR", "fragment-b/OUTCAR"], "resource_profile": {"parameter": "resource_profile"}, "recovery_policy": {"mode": "propose-only"}},
    {"id": "grid-check", "type": "validate", "depends_on": ["total-scf", "fragment-a-scf", "fragment-b-scf"], "validator": "charge.grid.compatibility", "artifacts_in": ["total/CHGCAR", "fragment-a/CHGCAR", "fragment-b/CHGCAR"], "artifacts_out": ["grid-check.json"]},
    {"id": "difference", "type": "charge_difference", "depends_on": ["grid-check"], "artifacts_in": ["total/CHGCAR", "fragment-a/CHGCAR", "fragment-b/CHGCAR"], "artifacts_out": ["CHGDIFF", "charge-difference.json", "charge-difference.png"], "parser": "charge.difference"},
    {"id": "report", "type": "report", "depends_on": ["difference"], "artifacts_in": ["charge-difference.json"], "artifacts_out": ["report.md"]}
  ]
}
